# Copia este archivo como ".env" y cambia los valores.
# El archivo .env NUNCA se sube a internet/GitHub.

PORT=3000

# Clave secreta para firmar las sesiones del administrador. Pon un texto largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# Usuario y contraseña del administrador (se crean la primera vez que arranca el servidor)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# (Opcional) Usuario EMPLEADO: ve todo el panel y solo puede confirmar citas pendientes.
# Si dejas estas dos líneas vacías o las borras, no existe usuario empleado.
STAFF_USER=
STAFF_PASSWORD=

# ---- AVISOS AL CELULAR DEL CLIENTE (opcional) ----
# Se generan UNA vez con:  npm install web-push   y luego   npx web-push generate-vapid-keys
# La clave PRIVADA es secreta: nunca la subas a GitHub (ponla en .env y en las Variables de Railway).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=tu-correo@ejemplo.com

# ---- Mensaje de WhatsApp (opcional) ----
# Nombre que aparece en el mensaje, y código de país (1 = República Dominicana / EE.UU.)
NEGOCIO=Beauty Salon
CODIGO_PAIS=1
